---
import { faqs } from "../data/faq";
---

<section id="faq" class="py-20 bg-[#111827] border-t border-gray-800">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl font-bold text-center text-white mb-12">
      Preguntas frecuentes
    </h2>

    {faqs.map((f, i) => (
      <details
        data-reveal
        style={`--reveal-delay:${i % 3}`}
        class="group bg-[#0b0f19] rounded-lg border border-gray-800 hover:border-[#3b82f6] open:border-[#3b82f6] transition-colors duration-200 mb-4"
      >
        <summary
          class="flex items-center justify-between gap-4 cursor-pointer select-none px-6 py-4 text-white font-semibold list-none [&::-webkit-details-marker]:hidden"
        >
          {f.question}
          <svg
            class="size-5 shrink-0 text-[#3b82f6] transition-transform duration-200 group-open:rotate-180"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p class="px-6 pb-5 text-gray-400">{f.answer}</p>
      </details>
    ))}
  </div>
</section>
