---
const services = [
  {
    title: "Sistemas administrativos, ERP y CRM a medida",
    description:
      "Sistemas a medida con roles y permisos: Laravel, MySQL y paquete Spatie para ERP y CRM adaptados a tu operación.",
  },
  {
    title: "APIs REST",
    description:
      "Diseño y desarrollo de APIs REST con autenticación, validación y documentación, listas para integrarse con web y apps móviles.",
  },
  {
    title: "Plataformas GPS con Traccar",
    description:
      "Instalación, personalización en Java y JavaScript, actualizaciones y respaldos de servidores GPS Traccar.",
  },
  {
    title: "Moodle: temas y app móvil",
    description:
      "Temas personalizados para Moodle 5 en web y app móvil con Ionic, además de integraciones con WordPress.",
  },
  {
    title: "Apps móviles con Flutter y React Native",
    description:
      "Desarrollo de apps móviles multiplataforma con Flutter y React Native, publicadas en App Store y Play Store.",
  },
  {
    title: "Infraestructura y despliegue",
    description:
      "Docker Swarm, GitHub Actions, GHCR y Portainer con monitoreo mediante Grafana y Prometheus.",
  },
];
---

<section id="servicios" class="py-20 bg-[#0b0f19]">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl font-bold text-center text-white mb-4">
      Áreas de especialidad
    </h2>
    <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
      Seis áreas en las que trabajo día a día
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service) => (
        <div class="bg-[#111827] p-6 rounded-lg border border-gray-800 hover:border-[#3b82f6] transition-colors duration-200">
          <h3 class="text-xl font-semibold text-white mb-3">
            {service.title}
          </h3>
          <p class="text-gray-400">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
