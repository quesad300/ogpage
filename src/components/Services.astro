---
const services = [
  {
    title: "Sistemas administrativos, ERP y CRM",
    description:
      "Gestión de finanzas, inventarios, clientes y reportes hecha a la medida de tu operación.",
  },
  {
    title: "Desarrollo web a medida e integraciones",
    description:
      "Portales, sistemas internos e integraciones que conectan tus aplicaciones y eliminan tareas repetitivas.",
  },
  {
    title: "Plataformas de rastreo GPS",
    description:
      "Control de flotas y activos en tiempo real con alertas, reportes e históricos.",
  },
  {
    title: "Formación en línea corporativa",
    description:
      "Cursos, seguimiento de avances y certificación para la capacitación de tu equipo.",
  },
  {
    title: "Aplicaciones móviles",
    description: "Apps para clientes y operación interna en iOS y Android.",
  },
  {
    title: "Infraestructura y despliegue continuo",
    description:
      "Servidores, redes y publicación automática para que tu sistema esté siempre disponible.",
  },
];

const process = [
  {
    title: "Descubrimiento",
    description: "Entendemos tu proceso y definimos el alcance contigo.",
  },
  {
    title: "Propuesta y plan",
    description: "Alcance, tiempos y costos claros antes de empezar.",
  },
  {
    title: "Desarrollo",
    description: "Entregas por etapas con avances visibles.",
  },
  {
    title: "Despliegue y soporte",
    description: "Puesta en marcha, capacitación y mantenimiento continuo.",
  },
];
---

<section id="servicios" class="py-20 bg-[#0b0f19]">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl font-bold text-center text-white mb-12">
      Soluciones
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, i) => (
        <div
          data-reveal
          data-tilt
          style={`--reveal-delay:${i % 3}`}
          class="bg-[#111827] p-6 rounded-lg border border-gray-800 hover:border-[#3b82f6] transition-colors duration-200"
        >
          <h3 class="text-xl font-semibold text-white mb-3">
            {service.title}
          </h3>
          <p class="text-gray-400">
            {service.description}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-20">
      <h3 class="text-2xl sm:text-3xl font-bold text-center text-white mb-10">
        Cómo trabajamos
      </h3>

      <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {process.map((step, i) => (
          <li
            data-reveal
            style={`--reveal-delay:${i % 4}`}
            class="bg-[#111827] p-6 rounded-lg border border-gray-800"
          >
            <p class="text-sm font-semibold text-[#3b82f6] uppercase tracking-widest mb-3">
              {step.title}
            </p>
            <p class="text-gray-400 text-sm">
              {step.description}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
