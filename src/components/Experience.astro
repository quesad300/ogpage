---
const experiences = [
  {
    company: "S21sistem",
    role: "Desarrollador de Software",
    period: "Dic 2025 - Actualidad",
    description: "Desarrollo de aplicaciones Android e iOS con React Native. Gestión de tiendas AppStore y PlayStore. Creación de sistema Laravel ERP, CRM y procesos para creación de cajas.",
  },
  {
    company: "Lidermel",
    role: "Desarrollador Software",
    period: "Sep 2023 - Sep 2025",
    description: "Desarrollo y mantenimiento de plataformas educativas y sitios web. Trabajo con Moodle, WordPress, Docker y proyectos frontend.",
  },
  {
    company: "Sistema Confianza",
    role: "Desarrollador Laravel",
    period: "Proyecto",
    description: "Sistema financiero para ventas de lotes inmobiliarios. Dashboard administrativo con gestión de clientes, contratos, pagos y reportes.",
  },
  {
    company: "Implementación Traccar",
    role: "Desarrollador Fullstack",
    period: "Proyecto",
    description: "Configuración de servidor GPS propio con Traccar. Personalización de interfaz de usuario para tracking de flota vehicular.",
  },
];
---

<section id="experiencia" class="py-20 bg-[#0b0f19]">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl font-bold text-center text-white mb-4">
      Experiencia
    </h2>
    <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
      Trayectoria profesional en desarrollo
    </p>
    
    <div class="relative">
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-gray-800"></div>
      
      <div class="space-y-12">
        {experiences.map((exp, index) => (
          <div class={`relative flex items-center ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-[#3b82f6] rounded-full -translate-x-1.5 mt-1.5"></div>
            
            <div class={`ml-12 md:ml-0 md:w-1/2 ${index % 2 === 0 ? 'md:pr-12' : 'md:pl-12'}`}>
              <div class="bg-[#111827] p-6 rounded-lg border border-gray-800">
                <span class="text-sm text-[#3b82f6] font-medium">
                  {exp.period}
                </span>
                <h3 class="text-lg font-semibold text-white mt-1">
                  {exp.role}
                </h3>
                <p class="text-gray-300 text-sm mt-1">
                  {exp.company}
                </p>
                <p class="text-gray-400 mt-3">
                  {exp.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>