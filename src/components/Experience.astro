---
const experiences = [
  {
    company: "s21sistem",
    role: "Desarrollador de Software",
    period: "dic. 2025 – abr. 2026",
    description:
      "ERP y CRM en Laravel con procesos para creación de cajas y publicación de 3 apps en App Store y Play Store con React Native.",
  },
  {
    company: "Lidermel",
    role: "Desarrollador Software (remoto)",
    period: "ago. 2021 – sep. 2025",
    description:
      "Plataforma educativa Moodle y app móvil: temas para Moodle 5 (web y app), WordPress y Docker en pruebas.",
  },
  {
    company: "Confianza Tu Agente Inmobiliario",
    role: "Desarrollador Laravel",
    period: "ago. 2024 – nov. 2024",
    description:
      "Sistema financiero inmobiliario para venta de lotes a cuotas: cartas compromiso, enganches y mensualidades, reportes auditables y paneles por rol con Spatie.",
  },
  {
    company: "Alcoholcity",
    role: "Desarrollador Fullstack (remoto)",
    period: "jun. 2020 – ago. 2022",
    description:
      "Ecosistema de 4 apps de delivery con Flutter, Firebase Functions, Mercado Pago y Google Maps.",
  },
  {
    company: "Escuela Preparatoria Villaflores",
    role: "",
    period: "jul. 2020 – jul. 2021",
    description:
      "Sistema para entrega de tareas y avisos; capacitación a alumnos y profesores para el uso de la plataforma.",
  },
  {
    company: "Tven",
    role: "",
    period: "ago. 2019 – feb. 2021",
    description: "[PENDIENTE: descripción del puesto]",
  },
  {
    company: "Transportes Fraylescanos",
    role: "Plataforma GPS Traccar (bajo demanda)",
    period: "ago. 2019 – actualidad",
    description:
      "Instalación, personalización de backend (Java) e interfaz (JavaScript) de Traccar, actualizaciones y respaldos.",
  },
  {
    company: "Regiobike",
    role: "",
    period: "abr. 2019 – ago. 2019",
    description: "[PENDIENTE: descripción del puesto]",
  },
  {
    company: "Tecknicos",
    role: "",
    period: "mar. 2018 – oct. 2018",
    description: "[PENDIENTE: descripción del puesto]",
  },
];
---

<section id="experiencia" class="py-20 bg-[#0b0f19]">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl font-bold text-center text-white mb-4">
      Experiencia
    </h2>
    <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
      Trayectoria profesional (desde 2018)
    </p>

    <div class="relative">
      <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-gray-800"></div>

      <div class="space-y-12">
        {experiences.map((exp, index) => (
          <div class={`relative flex items-center ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-[#3b82f6] rounded-full -translate-x-1.5 mt-1.5"></div>

            <div class={`ml-12 md:ml-0 md:w-1/2 ${index % 2 === 0 ? 'md:pr-12' : 'md:pl-12'}`}>
              <div class="bg-[#111827] p-6 rounded-lg border border-gray-800">
                <span class="text-sm text-[#3b82f6] font-medium">
                  {exp.period}
                </span>
                <h3 class="text-lg font-semibold text-white mt-1">
                  {exp.company}
                </h3>
                {exp.role && (
                  <p class="text-gray-300 text-sm mt-1">
                    {exp.role}
                  </p>
                )}
                <p class="text-gray-400 mt-3">
                  {exp.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
