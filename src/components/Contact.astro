---
const LINKEDIN_COMPANY = "https://www.linkedin.com/company/ogdevsecops";
---

<section id="contacto" class="py-20 bg-[#111827]">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
      Hablemos de tu proyecto
    </h2>
    <p class="text-gray-400 mb-10 max-w-2xl mx-auto">
      Cuéntanos qué proceso o sistema necesitas resolver y te respondemos por LinkedIn.
    </p>

    <div class="flex justify-center">
      <a
        href={LINKEDIN_COMPANY}
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-3 bg-[#3b82f6] text-white font-medium rounded-lg hover:bg-blue-600 transition-colors duration-200"
      >
        Hablemos en LinkedIn
      </a>
    </div>
  </div>
</section>
