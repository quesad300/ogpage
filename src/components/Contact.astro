---
// [PENDIENTE] Pegar aquí la access key de Web3Forms (gratis): https://web3forms.com
// 1) Regístrate con tu correo de OGDevSecOps  2) Copia la clave  3) Pégala abajo
const WEB3FORMS_ACCESS_KEY = "be0b33fc-356a-4501-abac-1b60a3e7cb7e";

const formData = [
  { name: "name", label: "Nombre", type: "text", required: true, autocomplete: "name" },
  { name: "empresa", label: "Empresa", type: "text", required: false, autocomplete: "organization" },
  { name: "email", label: "Correo electrónico", type: "email", required: true, autocomplete: "email" },
];
---

<section id="contacto" class="py-20 bg-[#111827]">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl font-bold text-center text-white mb-4">
      Cuéntanos tu proyecto
    </h2>
    <p class="text-gray-400 text-center mb-10 max-w-2xl mx-auto">
      Déjanos tus datos y una breve descripción del sistema o proceso que
      necesitas resolver. Te respondemos a tu correo.
    </p>

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="space-y-5 bg-[#0b0f19] rounded-lg border border-gray-800 p-6 sm:p-8"
    >
      <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
      <input type="hidden" name="subject" value="Nuevo mensaje desde ogdevsecops.sytes.net" />
      <input type="checkbox" name="botcheck" class="hidden" aria-hidden="true" tabindex="-1" />

      {formData.map((field) => (
        <div>
          <label for={field.name} class="mb-1 block text-sm font-medium text-gray-300">
            {field.label}{field.required && ' *'}
          </label>
          <input
            type={field.type}
            id={field.name}
            name={field.name}
            required={field.required}
            autocomplete={field.autocomplete}
            class="w-full rounded-lg border border-gray-700 bg-[#111827] px-4 py-2.5 text-white placeholder-gray-500 focus:border-[#3b82f6] focus:outline-none focus:ring-1 focus:ring-[#3b82f6]"
          />
        </div>
      ))}

      <div>
        <label for="message" class="mb-1 block text-sm font-medium text-gray-300">
          ¿Qué necesitas resolver? *
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          placeholder="Describe brevemente tu proceso o el sistema que necesitas…"
          class="w-full rounded-lg border border-gray-700 bg-[#111827] px-4 py-2.5 text-white placeholder-gray-500 focus:border-[#3b82f6] focus:outline-none focus:ring-1 focus:ring-[#3b82f6]"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full px-8 py-3 bg-[#3b82f6] text-white font-medium rounded-lg hover:bg-blue-600 transition-colors duration-200 sm:w-auto"
      >
        Enviar mensaje
      </button>

      <p class="text-xs text-gray-500">
        Usamos tus datos únicamente para responder a tu consulta. No
        compartimos tu información con terceros.
      </p>
    </form>
  </div>
</section>
