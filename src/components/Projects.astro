---
import { Image } from 'astro:assets';
import screenshotconfianza from '../assets/projects/screenshotconfianza.png';
import traccarscreenshot from '../assets/projects/traccarscreenshot.png';
import gymscreenshot from '../assets/projects/gymscreenshot.png';
import moodlescreenshot from '../assets/projects/moodlescreenshot.png';
import portainerScreenshot from '../assets/projects/portainer.png';

type Project = {
  title: string;
  period: string;
  description: string;
  tech: string[];
  image: ImageMetadata | null;
  alt: string;
  pending: string | null;
  link: string | null;
  /** URL de video (YouTube o mp4) que se abrirá en grande en lugar de la imagen */
  video?: string | null;
};

const projects: Project[] = [
  {
    title: "Plataforma GPS Traccar — Transportes Fraylescanos",
    period: "2019 – actualidad",
    description:
      "Instalación y operación de plataforma GPS con Traccar: personalización de backend (Java) e interfaz (JavaScript), actualizaciones y respaldos. Más de 100 unidades rastreadas.",
    tech: ["Traccar", "Java", "JavaScript", "Linux"],
    image: traccarscreenshot,
    alt: "Captura de la plataforma GPS Traccar de Transportes Fraylescanos",
    pending: null,
    link: null,
  },
  {
    title: "Sistema financiero inmobiliario — Confianza Tu Agente Inmobiliario",
    period: "ago. 2024 – nov. 2024",
    description:
      "Venta de lotes a cuotas: cartas compromiso, enganches y mensualidades, reportes auditables y paneles por rol con Spatie.",
    tech: ["Laravel", "MySQL", "Spatie"],
    image: screenshotconfianza,
    alt: "Captura del sistema financiero inmobiliario de Confianza Tu Agente Inmobiliario",
    pending: null,
    link: null,
  },
  {
    title: "Plataforma educativa Moodle y app móvil — Lidermel",
    period: "ago. 2021 – sep. 2025",
    description:
      "Temas personalizados para Moodle 5 en web y app móvil con Ionic, WordPress y pruebas con Docker (proyecto remoto).",
    tech: ["Moodle", "Ionic", "WordPress", "Docker"],
    image: moodlescreenshot,
    alt: "Captura de la plataforma educativa Moodle de Lidermel",
    pending: null,
    link: null,
  },
  {
    title: "Ecosistema de 4 apps de delivery — Alcoholcity",
    period: "jun. 2020 – ago. 2022",
    description:
      "Cuatro apps de delivery con Flutter y Firebase Functions, pagos con Mercado Pago y rutas con Google Maps (proyecto remoto).",
    tech: ["Flutter", "Firebase Functions", "Mercado Pago", "Google Maps"],
    image: null,
    alt: "",
    pending: "[PENDIENTE: captura o enlace público]",
    link: null,
  },
  {
    title: "ERP y CRM en Laravel y apps móviles — s21sistem",
    period: "dic. 2025 – abr. 2026",
    description:
      "Sistema con procesos para creación de cajas y publicación de 3 apps en App Store y Play Store con React Native.",
    tech: ["Laravel", "ERP", "CRM", "React Native"],
    image: null,
    alt: "",
    pending: "[PENDIENTE: captura o enlace público]",
    link: null,
  },
  {
    title: "Infraestructura Docker Swarm en producción",
    period: "ene. 2026 – actualidad",
    description:
      "Clúster Docker Swarm en producción distribuido en 3 VPS, con 17 stacks y 26 servicios (35 contenedores, 33 imágenes, 21 volúmenes y 10 redes) para aplicaciones Laravel, Moodle y otros sistemas, con despliegue continuo (GitHub Actions, GHCR, Portainer), monitoreo (Grafana, Prometheus), certificados SSL y dominios.",
    tech: ["Docker Swarm", "GitHub Actions", "GHCR", "Portainer", "Grafana", "Prometheus"],
    image: portainerScreenshot,
    alt: "Interfaz de Portainer en el clúster Docker Swarm en producción",
    pending: null,
    link: null,
  },
  {
    title: "Guerreros Gym",
    period: "Sitio web en producción",
    description:
      "Sitio web para gimnasio con información de servicios, horarios, planes y contacto. Diseño moderno y responsivo.",
    tech: ["WordPress", "Astra"],
    image: gymscreenshot,
    alt: "Captura del sitio web de Guerreros Gym",
    pending: null,
    link: "https://guerrerosgym.sytes.net/",
  },
];
---

<section id="proyectos" class="py-20 bg-[#111827]">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl font-bold text-center text-white mb-4">
      Proyectos
    </h2>
    <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
      Proyectos destacados con datos oficiales
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((project) => (
        <article class="bg-[#0b0f19] rounded-lg border border-gray-800 overflow-hidden hover:border-[#3b82f6] transition-colors duration-200 flex flex-col">
          {project.image && (
            <button
              type="button"
              class="group relative block h-56 w-full overflow-hidden cursor-zoom-in"
              data-type={project.video ? 'video' : 'image'}
              data-src={project.video || project.image.src}
              data-alt={project.alt}
              data-title={project.title}
              aria-label={`Ver en grande: ${project.title}`}
            >
              <Image
                src={project.image}
                alt={project.alt}
                loading="lazy"
                class="w-full h-full object-contain bg-gray-900 group-hover:scale-105 transition-transform duration-300"
              />
              {project.video && (
                <span class="absolute inset-0 grid place-items-center" aria-hidden="true">
                  <span class="rounded-full bg-black/70 border border-white/30 p-4 text-white text-xl leading-none">&#9654;</span>
                </span>
              )}
              <span class="absolute inset-0 grid place-items-center bg-black/50 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity duration-200" aria-hidden="true">
                <span class="text-white text-sm font-medium">Ver en grande</span>
              </span>
            </button>
          )}

          <div class="p-6 flex flex-col flex-1">
            <span class="text-sm text-[#3b82f6] font-medium mb-2">
              {project.period}
            </span>
            <h3 class="text-xl font-semibold text-white mb-3">
              {project.title}
            </h3>
            <p class="text-gray-400 mb-4">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              {project.tech.map((t) => (
                <span class="px-3 py-1 text-sm bg-[#3b82f6]/10 text-[#3b82f6] rounded-full border border-[#3b82f6]/20">
                  {t}
                </span>
              ))}
            </div>

            {project.pending && (
              <p class="text-sm text-amber-400 mb-4">{project.pending}</p>
            )}

            <div class="mt-auto">
              {project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block px-5 py-2 border border-gray-600 text-gray-300 text-sm font-medium rounded-lg hover:border-[#3b82f6] hover:text-[#3b82f6] transition-colors duration-200"
                >
                  Ver proyecto
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
      </div>
    </div>
  </div>

  <!-- Lightbox: vista en grande de imágenes/videos de proyectos -->
  <div
    id="media-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Vista ampliada de proyecto"
  >
    <button
      type="button"
      id="media-modal-close"
      class="absolute top-4 right-4 z-10 grid h-11 w-11 place-items-center rounded-full bg-black/60 border border-gray-600 text-gray-200 text-lg hover:border-blue-500 hover:text-white transition-colors"
      aria-label="Cerrar vista ampliada"
    >
      &#10005;
    </button>
    <figure class="flex max-h-full max-w-full flex-col items-center">
      <img id="media-modal-img" class="hidden max-h-[82vh] max-w-[92vw] rounded-lg object-contain" alt="" />
      <video id="media-modal-video" class="hidden max-h-[82vh] max-w-[92vw] rounded-lg" controls playsinline></video>
      <iframe
        id="media-modal-frame"
        class="hidden aspect-video w-[min(92vw,960px)] rounded-lg border-0"
        title="Video del proyecto"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
      <figcaption id="media-modal-caption" class="mt-3 max-w-2xl text-center text-sm text-gray-300"></figcaption>
    </figure>
  </div>
</section>

<script>
  const modal = document.getElementById('media-modal');
  const modalImg = document.getElementById('media-modal-img') as HTMLImageElement;
  const modalVideo = document.getElementById('media-modal-video') as HTMLVideoElement;
  const modalFrame = document.getElementById('media-modal-frame') as HTMLIFrameElement;
  const modalCaption = document.getElementById('media-modal-caption');
  const closeBtn = document.getElementById('media-modal-close');
  let lastFocused: HTMLElement | null = null;

  function toYouTubeEmbed(url: string): string | null {
    const m = url.match(/(?:youtu\.be\/|[?&]v=|shorts\/|embed\/)([\w-]{11})/);
    return m ? `https://www.youtube-nocookie.com/embed/${m[1]}?autoplay=1&rel=0` : null;
  }

  function hideAll() {
    modalImg.classList.add('hidden');
    modalVideo.classList.add('hidden');
    modalFrame.classList.add('hidden');
    modalVideo.pause();
    modalFrame.src = '';
  }

  function open(type: string, src: string, alt: string, title: string) {
    hideAll();
    modalCaption.textContent = title;
    if (type === 'video') {
      const yt = toYouTubeEmbed(src);
      if (yt) {
        modalFrame.src = yt;
        modalFrame.classList.remove('hidden');
      } else {
        modalVideo.src = src;
        modalVideo.classList.remove('hidden');
        modalVideo.play().catch(() => {});
      }
    } else {
      modalImg.src = src;
      modalImg.alt = alt;
      modalImg.classList.remove('hidden');
    }
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function close() {
    hideAll();
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  document.querySelectorAll<HTMLButtonElement>('button[data-src][data-type]').forEach((btn) => {
    if (!btn.dataset.type || !btn.dataset.src) return;
    btn.addEventListener('click', () => {
      lastFocused = btn;
      open(btn.dataset.type, btn.dataset.src, btn.dataset.alt ?? '', btn.dataset.title ?? '');
    });
  });

  closeBtn?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) close();
  });
</script>
