---
const LINKEDIN_COMPANY = "https://www.linkedin.com/company/ogdevsecops";
---

<section id="hero" class="min-h-screen flex items-center justify-center pt-16">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <p class="text-sm uppercase tracking-widest text-[#3b82f6] mb-4">
      México · Trabajo remoto
    </p>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
      Soluciones de software para empresas
    </h1>

    <p class="text-lg text-gray-400 max-w-3xl mx-auto mb-10">
      Desarrollamos sistemas administrativos, plataformas GPS, formación en línea y apps móviles, con infraestructura propia y despliegue continuo.
    </p>

    <div class="flex justify-center">
      <a
        href={LINKEDIN_COMPANY}
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-3 bg-[#3b82f6] text-white font-medium rounded-lg hover:bg-blue-600 transition-colors duration-200"
      >
        Hablemos en LinkedIn
      </a>
    </div>
  </div>
</section>
