---
const WHATSAPP_NUMBER = "529651352357";
const WHATSAPP_MESSAGE =
  "Hola José, vi tu sitio OGDevSecOps (ogdevsecops.sytes.net) y me gustaría hablar sobre un proyecto.";
const whatsappHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;
---

<section id="hero" class="min-h-screen flex items-center justify-center pt-16">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <p class="text-sm uppercase tracking-widest text-[#3b82f6] mb-4">
      OGDevSecOps
    </p>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
      Desarrollador Backend y DevOps | Laravel, APIs y sistemas administrativos | Docker Swarm · CI/CD · Traccar GPS · Moodle
    </h1>

    <p class="text-lg text-gray-400 max-w-3xl mx-auto mb-4">
      Desarrollador Backend y Fullstack con 8 años de experiencia (desde 2018)
      construyendo sistemas administrativos, APIs y plataformas web para empresas.
      Me especializo en Laravel y en plataformas GPS con Traccar, y también trabajo
      con Moodle, apps móviles (Flutter, React Native, Ionic) y despliegue con Docker y K3s.
    </p>

    <p class="text-base text-gray-500 max-w-2xl mx-auto mb-10">
      Villaflores, Chiapas, México. Trabajo remoto y disponible para reubicación
      en México y el extranjero.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-3 bg-[#3b82f6] text-white font-medium rounded-lg hover:bg-blue-600 transition-colors duration-200"
      >
        Escríbeme por WhatsApp
      </a>
      <a
        href="#proyectos"
        class="px-8 py-3 border border-gray-600 text-gray-300 font-medium rounded-lg hover:border-[#3b82f6] hover:text-[#3b82f6] transition-colors duration-200"
      >
        Ver proyectos
      </a>
    </div>
  </div>
</section>
