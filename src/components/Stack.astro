---
const groups = [
  {
    name: "Backend",
    techs: [
      "Laravel",
      "PHP",
      "MySQL",
      "MariaDB",
      "APIs REST",
      "Lumen",
      "Java (Traccar)",
      "TypeScript",
      "Firebase Functions",
      "Python (básico)",
      "Spatie",
    ],
  },
  {
    name: "Frontend",
    techs: [
      "JavaScript",
      "Ext JS (Traccar)",
      "React",
      "HTML",
      "CSS",
      "Tailwind",
      "Bootstrap",
    ],
  },
  {
    name: "Móvil",
    techs: ["Flutter", "React Native", "Ionic"],
  },
  {
    name: "Infraestructura",
    techs: [
      "Docker",
      "Docker Swarm",
      "K3s",
      "Nginx",
      "Redis",
      "Linux",
      "Git",
      "GitHub Actions",
      "Grafana",
      "Prometheus",
      "respaldos en la nube",
    ],
  },
  {
    name: "Plataformas",
    techs: ["Moodle", "WordPress", "Traccar"],
  },
];
---

<section id="tecnologias" class="py-20 bg-[#0b0f19]">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl font-bold text-center text-white mb-4">
      Tecnologías que dominamos
    </h2>
    <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
      Habilidades agrupadas por área
    </p>

    <div class="space-y-8">
      {groups.map((group) => (
        <div>
          <h3 class="text-lg font-medium text-gray-300 mb-4">{group.name}</h3>
          <div class="flex flex-wrap gap-3">
            {group.techs.map((tech) => (
              <span class="px-4 py-2 bg-[#0b0f19] border border-gray-700 rounded-lg text-gray-300 hover:border-[#3b82f6] hover:text-[#3b82f6] transition-colors duration-200">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
