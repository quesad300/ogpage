---
const backend = ["Laravel", "PHP", "MySQL"];
const frontend = ["React", "Next.js", "JavaScript", "Tailwind"];
const mobile = ["Flutter", "React Native", "Ionic"];
const other = ["Docker", "Moodle", "Traccar", "Linux", "Git"];
---

<section id="stack" class="py-20 bg-[#111827]">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl font-bold text-center text-white mb-4">
      Stack Tecnológico
    </h2>
    <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
      Tecnologías con las que trabajo diariamente
    </p>
    
    <div class="space-y-8">
      <div>
        <h3 class="text-lg font-medium text-gray-300 mb-4">Backend</h3>
        <div class="flex flex-wrap gap-3">
          {backend.map((tech) => (
            <span class="px-4 py-2 bg-[#0b0f19] border border-gray-700 rounded-lg text-gray-300 hover:border-[#3b82f6] hover:text-[#3b82f6] transition-colors duration-200">
              {tech}
            </span>
          ))}
        </div>
      </div>
      
      <div>
        <h3 class="text-lg font-medium text-gray-300 mb-4">Frontend</h3>
        <div class="flex flex-wrap gap-3">
          {frontend.map((tech) => (
            <span class="px-4 py-2 bg-[#0b0f19] border border-gray-700 rounded-lg text-gray-300 hover:border-[#3b82f6] hover:text-[#3b82f6] transition-colors duration-200">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-lg font-medium text-gray-300 mb-4">Móvil</h3>
        <div class="flex flex-wrap gap-3">
          {mobile.map((tech) => (
            <span class="px-4 py-2 bg-[#0b0f19] border border-gray-700 rounded-lg text-gray-300 hover:border-[#3b82f6] hover:text-[#3b82f6] transition-colors duration-200">
              {tech}
            </span>
          ))}
        </div>
      </div>
      
      <div>
        <h3 class="text-lg font-medium text-gray-300 mb-4">Otros</h3>
        <div class="flex flex-wrap gap-3">
          {other.map((tech) => (
            <span class="px-4 py-2 bg-[#0b0f19] border border-gray-700 rounded-lg text-gray-300 hover:border-[#3b82f6] hover:text-[#3b82f6] transition-colors duration-200">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
