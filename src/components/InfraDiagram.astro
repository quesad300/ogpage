---
/**
 * InfraDiagram.astro — diagrama animado del clúster de infraestructura.
 *
 * Topología oficial (enmienda del owner 2026-10-14):
 * - La VPN conecta TODO el clúster (VPS en distintas ubicaciones).
 * - Traefik (SSL) expone las webs públicas vía IP pública; el resto
 *   queda oculto, accesible solo por VPN.
 * Etiquetas visibles: solo el conjunto aprobado (sin cifras ni sinónimos).
 * Estructura: Traefik → bus VPN → VPS (managers/workers) → Contenedores,
 * con satélites de CI/CD, monitoreo, Portainer y respaldos.
 * Pulsos: CSS puro (pathLength=1 + stroke-dasharray), sin JS ni rAF.
 * Sin JS o con prefers-reduced-motion el SVG queda estático y completo.
 */

const coreNodes = [
  { cx: 150, cy: 130, grad: "halo-blue", delay: "0s" },
  { cx: 200, cy: 270, grad: "halo-blue", delay: "-0.48s" },
  { cx: 460, cy: 270, grad: "halo-blue", delay: "-0.96s" },
  { cx: 730, cy: 270, grad: "halo-blue", delay: "-1.44s" },
  { cx: 360, cy: 390, grad: "halo-blue", delay: "-1.92s" },
  { cx: 610, cy: 390, grad: "halo-blue", delay: "-2.4s" },
  { cx: 810, cy: 390, grad: "halo-blue", delay: "-2.88s" },
];

const satNodes = [
  { cx: 160, cy: 60, grad: "halo-cyan", delay: "-0.24s" },
  { cx: 330, cy: 60, grad: "halo-violet", delay: "-0.72s" },
  { cx: 600, cy: 60, grad: "halo-cyan", delay: "-1.2s" },
  { cx: 300, cy: 460, grad: "halo-violet", delay: "-1.68s" },
  { cx: 640, cy: 460, grad: "halo-cyan", delay: "-2.16s" },
];

// Flujo con pulsos sinápticos: Traefik → VPS → bus → managers/workers → contenedores
const flowLinks = [
  { d: "M158 152 C168 200 182 240 196 248", delay: "0s" },
  { d: "M222 270 H438", delay: "-0.43s" },
  { d: "M482 270 H708", delay: "-0.86s" },
  { d: "M460 292 C450 330 400 360 372 368", delay: "-1.29s" },
  { d: "M460 292 C500 330 560 360 592 368", delay: "-1.72s" },
  { d: "M730 292 C722 330 680 362 638 374", delay: "-2.15s" },
  { d: "M632 390 H788", delay: "-2.58s" },
];

const satLinks = [
  "M182 60 C230 60 260 60 308 60",
  "M330 82 C345 140 390 205 448 248",
  "M600 82 C620 140 690 205 722 248",
  "M300 438 C320 380 400 330 452 292",
  "M640 438 C690 420 760 405 788 396",
];
---

<svg
  class="infra-diagram w-full h-auto min-w-[640px]"
  viewBox="0 0 880 520"
  role="img"
  aria-labelledby="infra-t infra-d"
  data-reveal
>
  <title id="infra-t">Diagrama del clúster de infraestructura</title>
  <desc id="infra-d">La VPN conecta los VPS del clúster en distintas
    ubicaciones; Traefik con SSL expone las webs públicas vía IP pública y
    el resto queda oculto, accesible solo por VPN. Docker Swarm con managers
    y workers ejecutando contenedores Laravel, Moodle y otros sistemas;
    GitHub Actions y GHCR, Portainer, Grafana y Prometheus, respaldos en la
    nube.</desc>

  <defs>
    <radialGradient id="halo-blue">
      <stop offset="0" stop-color="#3b82f6"></stop>
      <stop offset="1" stop-color="#3b82f6" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="halo-cyan">
      <stop offset="0" stop-color="#22d3ee"></stop>
      <stop offset="1" stop-color="#22d3ee" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="halo-violet">
      <stop offset="0" stop-color="#a78bfa"></stop>
      <stop offset="1" stop-color="#a78bfa" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <!-- Enlaces principales + pulsos sinápticos (solo CSS) -->
  <g class="layer-links" style="--depth:.3">
    {
      flowLinks.map((link) => (
        <>
          <path d={link.d} class="link-base"></path>
          <path
            d={link.d}
            pathLength="1"
            class="synapse-pulse"
            style={`animation-delay:${link.delay}`}
          ></path>
        </>
      ))
    }
  </g>

  <!-- Satélites: CI/CD, monitoreo, Portainer y respaldos -->
  <g class="layer-satellites" style="--depth:1">
    {satLinks.map((d) => <path d={d} class="link-dash"></path>)}
    {
      satNodes.map((n) => (
        <g class="node">
          <circle
            class="node-halo"
            cx={n.cx}
            cy={n.cy}
            r="22"
            fill={`url(#${n.grad})`}
            style={`animation-delay:${n.delay}`}
          ></circle>
          <circle class="node-core" cx={n.cx} cy={n.cy} r="6" fill="#3b82f6"
          ></circle>
        </g>
      ))
    }
    <text x="160" y="36" text-anchor="middle" font-size="14" fill="#d1d5db">GitHub Actions</text>
    <text x="330" y="36" text-anchor="middle" font-size="14" fill="#d1d5db">GHCR</text>
    <text x="600" y="36" text-anchor="middle" font-size="14" fill="#d1d5db">Portainer</text>
    <text x="300" y="500" text-anchor="middle" font-size="14" fill="#d1d5db">Grafana + Prometheus</text>
    <text x="640" y="500" text-anchor="middle" font-size="14" fill="#d1d5db">Respaldos en la nube</text>
  </g>

  <!-- Núcleo: Traefik → VPN → VPS · Managers/Workers → Contenedores -->
  <g class="layer-core" style="--depth:.6">
    {
      coreNodes.map((n) => (
        <g class="node">
          <circle
            class="node-halo"
            cx={n.cx}
            cy={n.cy}
            r="22"
            fill={`url(#${n.grad})`}
            style={`animation-delay:${n.delay}`}
          ></circle>
          <circle class="node-core" cx={n.cx} cy={n.cy} r="6" fill="#3b82f6"
          ></circle>
        </g>
      ))
    }
  </g>

  <!-- Etiquetas del flujo (sin cifras) -->
  <g class="layer-labels" style="--depth:.6">
    <text x="150" y="174" text-anchor="middle" font-size="15" fill="#e5e7eb">Traefik · SSL</text>
    <text x="150" y="196" text-anchor="middle" font-size="14" fill="#9ca3af">IP pública</text>
    <text x="95" y="252" text-anchor="start" font-size="15" fill="#e5e7eb">VPN</text>
    <text x="200" y="308" text-anchor="middle" font-size="14" fill="#9ca3af">VPS</text>
    <text x="460" y="308" text-anchor="middle" font-size="14" fill="#9ca3af">VPS</text>
    <text x="730" y="308" text-anchor="middle" font-size="14" fill="#9ca3af">VPS</text>
    <text x="360" y="430" text-anchor="middle" font-size="15" fill="#e5e7eb">Managers</text>
    <text x="610" y="430" text-anchor="middle" font-size="15" fill="#e5e7eb">Workers</text>
    <text x="500" y="352" text-anchor="middle" font-size="14" fill="#9ca3af">Clúster Docker Swarm</text>
    <text x="810" y="430" text-anchor="middle" font-size="15" fill="#e5e7eb">Contenedores</text>
    <text x="810" y="456" text-anchor="middle" font-size="14" fill="#9ca3af">Laravel</text>
    <text x="810" y="478" text-anchor="middle" font-size="14" fill="#9ca3af">Moodle</text>
    <text x="810" y="500" text-anchor="middle" font-size="14" fill="#9ca3af">otros sistemas</text>
  </g>
</svg>
