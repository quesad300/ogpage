---
import "../styles/global.css";

const SITE = "https://ogdevsecops.sytes.net";

const OFFICIAL_TITLE = "OGDevSecOps | Soluciones de software para empresas";
const OFFICIAL_DESCRIPTION =
  "OGDevSecOps desarrolla sistemas administrativos, APIs, plataformas GPS y formación en línea para empresas, con infraestructura propia y despliegue continuo.";
const OFFICIAL_KEYWORDS =
  "soluciones de software para empresas, ERP a medida, desarrollo web, APIs, plataformas GPS, formación en línea, apps móviles, infraestructura y despliegue";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = OFFICIAL_TITLE,
  description = OFFICIAL_DESCRIPTION,
  image = "/og-image.png",
  noindex = false,
} = Astro.props;

const site = Astro.site || new URL(SITE);
const canonicalURL = new URL(Astro.url.pathname, site);

const LINKEDIN_COMPANY = "https://www.linkedin.com/company/ogdevsecops";
const LINKEDIN_PROFILE =
  "https://www.linkedin.com/in/jos%C3%A9-oswaldo-guerrero-p%C3%A9rez-2843791aa";

const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "OGDevSecOps",
      url: `${SITE}/`,
      sameAs: [LINKEDIN_COMPANY],
      description: OFFICIAL_DESCRIPTION,
      founder: { "@id": `${SITE}/#person` },
    },
    {
      "@type": "WebSite",
      name: "OGDevSecOps",
      url: SITE,
      inLanguage: "es-MX",
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#person`,
      name: "José Oswaldo Guerrero Pérez",
      sameAs: [LINKEDIN_PROFILE],
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={OFFICIAL_KEYWORDS} />
    <meta name="author" content="OGDevSecOps" />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OGDevSecOps" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="OGDevSecOps — Soluciones de software para empresas"
    />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@OGDevSecOps" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site).href} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#0b0f19" />
  </head>
  <body class="bg-[#0b0f19] text-[#e5e7eb] min-h-screen">
    <slot />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
