---
import "../styles/global.css";
import { faqs } from "../data/faq";

const SITE = "https://ogdevsecops.sytes.net";

const OFFICIAL_TITLE =
  "OGDevSecOps | Software y ERP a medida: Laravel, APIs y GPS";
const OFFICIAL_DESCRIPTION =
  "OGDevSecOps desarrolla ERP y software a medida con Laravel, APIs REST y plataformas GPS Traccar, con infraestructura Docker y despliegue continuo.";
const OFFICIAL_KEYWORDS =
  "soluciones de software para empresas, ERP a medida, desarrollo web, APIs, plataformas GPS, formación en línea, apps móviles, infraestructura y despliegue";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = OFFICIAL_TITLE,
  description = OFFICIAL_DESCRIPTION,
  image = "/og-image.png",
  noindex = false,
} = Astro.props;

const site = Astro.site || new URL(SITE);
const canonicalURL = new URL(Astro.url.pathname, site);

const LINKEDIN_COMPANY = "https://www.linkedin.com/company/ogdevsecops";
const LINKEDIN_PROFILE =
  "https://www.linkedin.com/in/jos%C3%A9-oswaldo-guerrero-p%C3%A9rez-2843791aa";

const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "OGDevSecOps",
      url: `${SITE}/`,
      logo: `${SITE}/logoogdevsecops.png`,
      sameAs: [
        LINKEDIN_COMPANY,
        "https://github.com/quesad300",
        "https://www.youtube.com/@OGDevSecOps",
        "https://www.facebook.com/profile.php?id=61583853565636",
      ],
      description: OFFICIAL_DESCRIPTION,
      areaServed: ["México", "Remoto (internacional)"],
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "joseoswaldogperez@gmail.com",
        availableLanguage: ["es"],
      },
      founder: { "@id": `${SITE}/#person` },
    },
    {
      "@type": "WebSite",
      name: "OGDevSecOps",
      url: SITE,
      inLanguage: "es-MX",
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#person`,
      name: "José Oswaldo Guerrero Pérez",
      sameAs: [LINKEDIN_PROFILE],
    },
    {
      "@type": "FAQPage",
      "@id": `${SITE}/#faq`,
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: f.answer,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={OFFICIAL_KEYWORDS} />
    <meta name="author" content="OGDevSecOps" />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/logoogdevsecops.png" />
    <link rel="alternate icon" href="/logoogdevsecops.png" />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OGDevSecOps" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="OGDevSecOps — Software y ERP a medida con Laravel, APIs y GPS"
    />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@OGDevSecOps" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site).href} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#0b0f19" />
  </head>
  <body class="bg-[#0b0f19] text-[#e5e7eb] min-h-screen">
    <canvas
      id="ambient-canvas"
      class="fixed inset-0 -z-10 pointer-events-none"
      aria-hidden="true"></canvas>
    <slot />
    <script>
      import "../scripts/motion.ts";
    </script>
    <script>
      import "../scripts/ambient.ts";
    </script>
  </body>
</html>
